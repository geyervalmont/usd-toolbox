def "Looks"
{
    def Material "Timber"
    {
        token outputs:surface.connect = </Looks/Timber/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.3, 0.14, 0.055)
            float inputs:metallic = 0
            float inputs:roughness = 0.45
            token outputs:surface
        }
    }

    def Material "Frame"
    {
        token outputs:surface.connect = </Looks/Frame/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.04, 0.05, 0.06)
            float inputs:metallic = 0.8
            float inputs:roughness = 0.25
            token outputs:surface
        }
    }
}

